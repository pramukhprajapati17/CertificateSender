<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Certificate Mailer
    </title>


    <!-- ===================================================== -->
    <!-- BOOTSTRAP -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- ===================================================== -->
    <!-- BOOTSTRAP ICONS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- ===================================================== -->
    <!-- APPLICATION CSS -->
    <!-- ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body class="bg-light">


    <!-- ===================================================== -->
    <!-- NAVBAR -->
    <!-- ===================================================== -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">

        <div class="container">


            <!-- BRAND -->

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-award-fill text-primary me-2"></i>

                Certificate Mailer

            </a>


            <!-- MOBILE TOGGLE -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- NAVIGATION -->

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">


                    <!-- HOME -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house me-1"></i>

                            Home

                        </a>

                    </li>


                    <!-- SETUP -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           asp-controller="Certificate"
                           asp-action="Setup">

                            <i class="bi bi-gear me-1"></i>

                            Setup

                        </a>

                    </li>


                    <!-- STUDENTS -->

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           asp-controller="Certificate"
                           asp-action="Students">

                            <i class="bi bi-people me-1"></i>

                            Students

                        </a>

                    </li>


                </ul>

            </div>

        </div>

    </nav>



    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <main class="container py-4">


        <!-- ================================================= -->
        <!-- SUCCESS MESSAGE -->
        <!-- ================================================= -->

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["Message"]


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- ================================================= -->
        <!-- ERROR MESSAGE -->
        <!-- ================================================= -->

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-exclamation-triangle-fill me-2"></i>

                @TempData["Error"]


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- ================================================= -->
        <!-- PAGE CONTENT -->
        <!-- ================================================= -->

        @RenderBody()

    </main>



    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <footer class="bg-dark text-white-50 mt-5 py-4">

        <div class="container">

            <div class="row align-items-center">


                <!-- BRAND -->

                <div class="col-md-6 text-center text-md-start">

                    <div class="fw-bold text-white">

                        <i class="bi bi-award-fill text-primary me-2"></i>

                        Certificate Mailer

                    </div>

                    <small>
                        Automated Certificate Delivery System
                    </small>

                </div>


                <!-- COPYRIGHT -->

                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">

                    <small>

                        &copy; @DateTime.Now.Year
                        Powered by Pramukh Prajapati
                    </small>

                </div>

            </div>

        </div>

    </footer>



    <!-- ===================================================== -->
    <!-- BOOTSTRAP JAVASCRIPT -->
    <!-- ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- ===================================================== -->
    <!-- APPLICATION JAVASCRIPT -->
    <!-- ===================================================== -->

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- ===================================================== -->
    <!-- PAGE SCRIPTS -->
    <!-- ===================================================== -->

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>

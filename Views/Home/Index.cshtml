@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">

    <div class="row align-items-center">

        <div class="col-lg-7">

            <span class="badge bg-primary mb-3">
                <i class="bi bi-lightning-fill me-1"></i>
                Automated Certificate Delivery
            </span>


            <h1 class="display-4 fw-bold mb-3">
                Generate & Send
                <span class="text-primary">
                    Certificates
                </span>
                Automatically
            </h1>


            <p class="lead text-muted mb-4">

                Upload your certificate template and
                student Excel file. Personalize each
                certificate with the student's name and
                send it directly to their email.

            </p>


            <div class="d-flex gap-3 flex-wrap">

                <a asp-controller="Certificate"
                   asp-action="Setup"
                   class="btn btn-primary btn-lg">

                    <i class="bi bi-rocket-takeoff me-2"></i>
                    Start Now

                </a>


                <a asp-controller="Certificate"
                   asp-action="Students"
                   class="btn btn-outline-secondary btn-lg">

                    <i class="bi bi-people me-2"></i>
                    View Students

                </a>

            </div>

        </div>


        <div class="col-lg-5 mt-5 mt-lg-0">

            <div class="dashboard-preview">

                <div class="preview-icon">
                    <i class="bi bi-award-fill"></i>
                </div>


                <h3 class="mt-3">
                    Certificate Mailer
                </h3>


                <p class="text-muted">
                    A simple workflow for bulk
                    personalized certificates.
                </p>


                <div class="workflow">

                    <div class="workflow-item">

                        <span>1</span>

                        <div>
                            <strong>Upload</strong>
                            <small>Template & Excel</small>
                        </div>

                    </div>


                    <div class="workflow-item">

                        <span>2</span>

                        <div>
                            <strong>Personalize</strong>
                            <small>Position & style</small>
                        </div>

                    </div>


                    <div class="workflow-item">

                        <span>3</span>

                        <div>
                            <strong>Send</strong>
                            <small>Email certificates</small>
                        </div>

                    </div>


                    <div class="workflow-item">

                        <span>4</span>

                        <div>
                            <strong>Track</strong>
                            <small>Download result Excel</small>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

